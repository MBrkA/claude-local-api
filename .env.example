# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# API Configuration
API_PREFIX=/api

# Optional API key to protect endpoints; leave empty to disable auth
API_KEY=""

# Claude Code CLI
# Path or command name used to invoke the Claude Code CLI
CLAUDE_BIN_PATH=claude
# Default working directory the `claude` subprocess runs in when a request
# doesn't specify one. Defaults to the process cwd if left empty.
CLAUDE_DEFAULT_CWD=""
